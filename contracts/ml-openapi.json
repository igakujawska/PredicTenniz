{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "BatchResult": {
        "additionalProperties": false,
        "properties": {
          "asOf": {
            "format": "date",
            "title": "Asof",
            "type": "string"
          },
          "bestOf": {
            "enum": [
              3,
              5
            ],
            "title": "Bestof",
            "type": "integer"
          },
          "modelVersion": {
            "title": "Modelversion",
            "type": "string"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/PredictionOutcome"
            },
            "title": "Predictions",
            "type": "array"
          },
          "surface": {
            "enum": [
              "HARD",
              "CLAY",
              "GRASS"
            ],
            "title": "Surface",
            "type": "string"
          }
        },
        "required": [
          "modelVersion",
          "asOf",
          "surface",
          "bestOf",
          "predictions"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "Benchmarks": {
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "$ref": "#/components/schemas/Scores"
          },
          "coinFlip": {
            "$ref": "#/components/schemas/Scores"
          },
          "ml": {
            "$ref": "#/components/schemas/Scores"
          }
        },
        "required": [
          "ml",
          "baseline",
          "coinFlip"
        ],
        "title": "Benchmarks",
        "type": "object"
      },
      "ModelDescription": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Benchmarks"
              },
              {
                "type": "null"
              }
            ]
          },
          "testMatches": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Testmatches"
          },
          "testYear": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Testyear"
          },
          "trained": {
            "title": "Trained",
            "type": "boolean"
          },
          "trainedThrough": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trainedthrough"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "label",
          "trained"
        ],
        "title": "ModelDescription",
        "type": "object"
      },
      "PredictionBatch": {
        "additionalProperties": false,
        "properties": {
          "asOf": {
            "format": "date",
            "title": "Asof",
            "type": "string"
          },
          "bestOf": {
            "enum": [
              3,
              5
            ],
            "title": "Bestof",
            "type": "integer"
          },
          "modelVersion": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Modelversion",
            "type": "string"
          },
          "pairs": {
            "items": {
              "$ref": "#/components/schemas/PredictionPair"
            },
            "maxItems": 120,
            "minItems": 1,
            "title": "Pairs",
            "type": "array"
          },
          "surface": {
            "enum": [
              "HARD",
              "CLAY",
              "GRASS"
            ],
            "title": "Surface",
            "type": "string"
          }
        },
        "required": [
          "modelVersion",
          "asOf",
          "surface",
          "bestOf",
          "pairs"
        ],
        "title": "PredictionBatch",
        "type": "object"
      },
      "PredictionOutcome": {
        "additionalProperties": false,
        "properties": {
          "playerAId": {
            "title": "Playeraid",
            "type": "integer"
          },
          "playerBId": {
            "title": "Playerbid",
            "type": "integer"
          },
          "probabilityA": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probabilitya",
            "type": "number"
          },
          "probabilityB": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probabilityb",
            "type": "number"
          }
        },
        "required": [
          "playerAId",
          "playerBId",
          "probabilityA",
          "probabilityB"
        ],
        "title": "PredictionOutcome",
        "type": "object"
      },
      "PredictionPair": {
        "additionalProperties": false,
        "properties": {
          "playerAId": {
            "exclusiveMinimum": 0.0,
            "title": "Playeraid",
            "type": "integer"
          },
          "playerBId": {
            "exclusiveMinimum": 0.0,
            "title": "Playerbid",
            "type": "integer"
          },
          "rankA": {
            "exclusiveMinimum": 0.0,
            "maximum": 2147483647.0,
            "title": "Ranka",
            "type": "integer"
          },
          "rankB": {
            "exclusiveMinimum": 0.0,
            "maximum": 2147483647.0,
            "title": "Rankb",
            "type": "integer"
          },
          "sourceAId": {
            "anyOf": [
              {
                "pattern": "^[1-9][0-9]{0,15}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceaid"
          },
          "sourceBId": {
            "anyOf": [
              {
                "pattern": "^[1-9][0-9]{0,15}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcebid"
          }
        },
        "required": [
          "playerAId",
          "playerBId",
          "rankA",
          "rankB"
        ],
        "title": "PredictionPair",
        "type": "object"
      },
      "Scores": {
        "additionalProperties": false,
        "properties": {
          "accuracy": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Accuracy",
            "type": "number"
          },
          "brierScore": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Brierscore",
            "type": "number"
          },
          "logLoss": {
            "minimum": 0.0,
            "title": "Logloss",
            "type": "number"
          }
        },
        "required": [
          "logLoss",
          "brierScore",
          "accuracy"
        ],
        "title": "Scores",
        "type": "object"
      },
      "ValidationIssue": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Internal prediction engine. Spring Boot owns players, tournaments and PostgreSQL.",
    "title": "PredictTeniz ML API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "models_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelDescription"
                  },
                  "title": "Response Models V1 Models Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Models",
        "tags": [
          "models"
        ]
      }
    },
    "/v1/predict": {
      "post": {
        "description": "Predict every possible pair once; Java reuses this matrix throughout a tournament draw.",
        "operationId": "predict_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Predict",
        "tags": [
          "predictions"
        ]
      }
    }
  }
}
